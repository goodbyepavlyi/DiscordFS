{
    "name": "discordfs",
    "description": "DiscordFS",
    "version": "2.0.0",
    "main": "dist/src/index.js",
    "scripts": {
        "start": "node dist/src/index.js",
        "build": "tsc -p tsconfig.json",
        "build:watch": "nodemon --ext ts --exec \"npm run build && node dist/src/index.js -dev || exit 1\""
    },
    "dependencies": {
        "axios": "^1.7.9",
        "discord.js": "^14.16.3",
        "dotenv": "^16.4.7",
        "memfs": "^4.15.0",
        "mutable-buffer": "^4.0.2",
        "stream": "^0.0.3",
        "webdav-server": "^2.6.2"
    },
    "devDependencies": {
        "nodemon": "^3.1.9",
        "typescript": "^5.7.2"
    },
    "nodemonConfig": {
        "ignore": [
            "Data/"
        ]
    }
}
